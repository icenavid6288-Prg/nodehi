APP_NAME="نودهی"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nodehi
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nodehi.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ── فرانت‌اند ─────────────────────────────────────────────
# تنها مبدأ مجاز CORS. در تولید دامنهٔ واقعی سایت را بگذارید.
FRONTEND_URL=http://localhost:5173

# ── پرداخت آنلاین (زرین‌پال) ─────────────────────────────
# شناسهٔ پذیرندهٔ ۳۶ کاراکتری. اگر در پنل مدیریت (درگاه online) مقداری ثبت
# شود، همان مقدار بر این متغیر اولویت دارد.
ZARINPAL_MERCHANT_ID=
# true یعنی sandbox.zarinpal.com؛ در تولید false بگذارید.
ZARINPAL_SANDBOX=true
# باید با دامنهٔ ثبت‌شده در زرین‌پال یکی باشد (خطای ‎-14 نتیجهٔ ناهمخوانی است).
# پیش‌فرض: ${APP_URL}/api/payments/zarinpal/callback
ZARINPAL_CALLBACK_URL=

# ── احراز هویت با کد یک‌بارمصرف ───────────────────────────
# طول عمر نشست (روز)
AUTH_SESSION_DAYS=30
# فقط برای توسعه: کد را در پاسخ API برمی‌گرداند تا بدون سرویس پیامک
# بتوان وارد شد. در تولید باید APP_DEBUG=false باشد.
AUTH_OTP_DEV_MODE=1

# ── پیامک (کاوه‌نگار) ────────────────────────────────────
# بدون این دو مقدار، ورود در محیط تولید با خطای روشن ۵۰۳ متوقف می‌شود
# تا هرگز پیام «کد ارسال شد» بدون ارسال واقعی نمایش داده نشود.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=10008663
KAVENEGAR_OTP_TEMPLATE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
