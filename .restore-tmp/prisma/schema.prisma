// ─────────────────────────────────────────────────────────────────────────────
//  اسکیمای دیتابیس نودهی (نسخه اجرایی)
// ─────────────────────────────────────────────────────────────────────────────
//  چرا SQLite؟ این محیط هیچ سرور PostgreSQL/Docker ندارد، پس دیتابیس باید
//  بدون سرویس بیرونی کار کند. موتور SQLite همراه Prisma می‌آید و یک دیتابیس
//  واقعی فایلی با migration و SQL واقعی می‌سازد.
//
//  ⚠️ این اسکیما عمداً «قابل حمل» نوشته شده تا انتقال به PostgreSQL در تولید
//  فقط تغییر provider و url باشد، نه بازنویسی مدل‌ها. برای همین:
//    • به‌جای enum از String استفاده شده (در Postgres می‌توان بعداً enum کرد)
//    • هیچ آرایه اسکالر (String[]) به‌کار نرفته — روی SQLite پشتیبانی نمی‌شود
//    • هیچ فیلد Json یا @db.* بومی Postgres استفاده نشده
//  راهنمای کامل انتقال در docs/ARCHITECTURE.md آمده است.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  کاربران و احراز هویت
// ─────────────────────────────────────────────────────────────

/// کاربر فروشگاه.
/// ورود تنها با «شماره تلفن» و کد یک‌بارمصرف (OTP) انجام می‌شود؛ رمز عبوری
/// وجود ندارد. این طراحی هم ساده‌تر است و هم سطح حمله را کم می‌کند: چیزی برای
/// لو رفتن یا هش کردن وجود ندارد.
model User {
  id String @id @default(cuid())

  /// شماره همراه به قالب یکسان‌شده ۰۹xxxxxxxxx — کلید ورود
  phone String @unique

  firstName String?
  lastName  String?
  email     String? @unique

  /// نقش: customer | operator | accountant | admin
  role String @default("customer")

  isActive Boolean @default(true)

  /// زمان تأیید شماره همراه — تا تأیید نشدن، ورود کامل نیست
  phoneVerifiedAt DateTime?

  /// باشگاه مشتریان
  loyaltyPoints Int    @default(0)
  loyaltyTier   String @default("برنزی")

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses    Address[]
  orders       Order[]
  sessions     Session[]
  reviews      Review[]
  auditLogs    AuditLog[]
  stockAlerts  StockAlert[]
  smsMessages  SmsMessage[]

  @@index([phone])
  @@index([role])
}

/// کد یک‌بارمصرف ارسال‌شده با پیامک.
/// کد به‌صورت هش ذخیره می‌شود تا اگر دیتابیس لو رفت، کدهای فعال قابل
/// استفاده نباشند. هر رکورد تعداد تلاش محدود دارد تا حمله Brute Force
/// روی کد ۵ رقمی عملی نباشد.
model OtpCode {
  id String @id @default(cuid())

  phone String

  /// هش SHA-256 کد — کد خام هرگز ذخیره نمی‌شود
  codeHash String

  /// منظور: login | verify_phone
  purpose String @default("login")

  /// تعداد تلاش‌های ناموفق برای تأیید
  attempts Int @default(0)

  /// پایان اعتبار کد
  expiresAt DateTime

  /// زمان مصرف — مقدار داشتن یعنی کد دیگر قابل استفاده نیست
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

/// نشست ورود کاربر.
/// توکن خام فقط در کوکی مرورگر قرار می‌گیرد؛ در دیتابیس تنها هش آن ذخیره
/// می‌شود تا کوکی دزدیده‌شده از روی نسخه پشتیبان قابل بازسازی نباشد.
model Session {
  id String @id @default(cuid())

  /// هش SHA-256 توکن نشست
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  /// برای نمایش «دستگاه‌های فعال» و امکان قطع نشست مشکوک
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// آدرس‌های ارسال کاربر
model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String  @default("خانه")
  receiver   String
  phone      String
  province   String
  city       String
  line       String
  postalCode String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
//  سفارش‌ها
// ─────────────────────────────────────────────────────────────

/// سفارش ثبت‌شده.
/// اقلام در جدول جداگانه نگه داشته می‌شوند و «نام و قیمت واحد» در همان لحظه
/// ثبت، کپی می‌شود. دلیل: اگر قیمت کاتالوگ بعداً تغییر کند، فاکتور قدیمی
/// نباید عوض شود — فاکتور باید تصویر لحظه خرید بماند.
model Order {
  id String @id @default(cuid())

  /// شماره خوانا برای مشتری
  orderNumber String @unique

  /// مهمان هم می‌تواند سفارش ثبت کند
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// وضعیت: pending | paid | processing | shipped | delivered | cancelled
  status String @default("pending")

  /// روش پرداخت: online | cod | installment
  paymentMethod String

  shippingMethod String

  couponCode String?

  subtotal Int
  discount Int @default(0)
  shipping Int @default(0)
  total    Int

  // ── تصویر لحظه‌ای گیرنده (کپی، نه ارجاع) ──
  customerFirstName  String
  customerLastName   String
  customerPhone      String
  customerEmail      String?
  shippingProvince   String
  shippingCity       String
  shippingLine       String
  shippingPostalCode String?

  trackingCode String?
  note         String?

  /// کلید جلوگیری از ثبت تکراری هنگام ارسال دوباره درخواست
  idempotencyKey String? @unique

  // ── پرداخت آنلاین (زرین‌پال) / اقساطی (اسنپ‌پی) ──
  /// شناسه تراکنش درگاه: برای زرین‌پال authority و برای اسنپ‌پی paymentToken.
  /// یکتاست تا پاسخ بازگشتی هرگز به سفارش دیگری نچسبد.
  paymentAuthority String? @unique

  /// آدرس صفحه پرداخت درگاه (فقط اسنپ‌پی): برای «ادامه پرداخت» دوباره بدون
  /// ساخت تراکنش تازه. زرین‌پال آدرسش از authority ساخته می‌شود و نیازی ندارد.
  paymentRedirectUrl String?

  /// شماره مرجع بانکی (ref_id) — فقط پس از تأیید موفق پر می‌شود
  paymentRefId String?

  /// فقط ۴ رقم آخر کارت (مثل ****1234). شماره کامل کارت هرگز ذخیره نمی‌شود.
  paymentCardPan String?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// یک قلم از سفارش
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// ارجاع نرم به کاتالوگ (نامک، نه کلید خارجی) — هم‌راستا با Review و StockAlert.
  /// عمداً کلید خارجی نیست: کالا می‌تواند حذف یا غیرفعال شود ولی سطر سفارش
  /// باید سالم بماند (نام و قیمت هم در همین سطر کپی شده‌اند).
  productSlug String

  /// کپی نام و قیمت در لحظه ثبت سفارش
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
  @@index([productSlug])
}

// ─────────────────────────────────────────────────────────────
//  بازاریابی و محتوا
// ─────────────────────────────────────────────────────────────

/// کد تخفیف / کمپین
model Coupon {
  id String @id @default(cuid())

  /// همیشه با حروف بزرگ ذخیره می‌شود
  code    String  @unique
  label   String
  percent Int

  minSubtotal Int?

  /// سقف استفاده کل — null یعنی نامحدود
  maxUses   Int?
  usedCount Int  @default(0)

  startsAt  DateTime?
  expiresAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// نظر کاربر روی محصول
model Review {
  id String @id @default(cuid())

  productSlug String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  author String
  rating Int
  title  String
  body   String

  /// وضعیت: pending | approved | rejected
  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productSlug])
  @@index([productSlug, status])
}

/// پیام فرم تماس با ما
model ContactMessage {
  id String @id @default(cuid())

  name    String
  phone   String
  email   String?
  subject String
  message String

  /// وضعیت: new | in_progress | resolved
  status String @default("new")

  createdAt DateTime @default(now())

  @@index([status])
}

/// درخواست اطلاع‌رسانی موجود شدن کالا
model StockAlert {
  id String @id @default(cuid())

  productSlug String

  phone String
  email String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  notifiedAt DateTime?

  createdAt DateTime @default(now())

  /// یک کاربر برای یک محصول فقط یک بار ثبت می‌شود
  @@unique([productSlug, phone])
  @@index([notifiedAt])
}

// ─────────────────────────────────────────────────────────────
//  تنظیمات و یکپارچه‌سازی‌ها
// ─────────────────────────────────────────────────────────────

/// تنظیمات سامانه به شکل کلید/مقدار.
///
/// چرا جدول و نه فایل؟ تنظیمات باید از پنل مدیریت و بدون انتشار دوباره سایت
/// تغییر کنند. کلیدها در کد تعریف می‌شوند (`lib/server/settings.ts`) و این
/// جدول فقط مقدار را نگه می‌دارد؛ پس یک کلید ناشناخته هرگز اثر نمی‌گذارد.
model Setting {
  id String @id @default(cuid())

  /// کلید یکتا مثل `sms.apiKey` یا `pages.hero.title`
  key String @unique

  /// گروه برای نمایش در پنل: general | pages | sms | payments | automation
  group String

  /// مقدار به شکل متن. اگر secret باشد، رمزنگاری‌شده ذخیره می‌شود.
  value String?

  /// مقدار حساس: هرگز به مرورگر فرستاده نمی‌شود و در لاگ حسابرسی چاپ نمی‌گردد
  isSecret Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([group])
}

/// لاگ پیامک‌های ارسالی.
///
/// بدون این جدول، «آیا کد ورود واقعاً برای مشتری رفت؟» پاسخ‌پذیر نبود و
/// عیب‌یابی سرویس پیامک کورکورانه بود.
model SmsMessage {
  id String @id @default(cuid())

  phone String

  /// منظورت ارسال: otp | notification | test
  purpose String @default("notification")

  /// قالب استفاده‌شده در سرویس پیامک (اگر ارسال قالب‌محور باشد)
  template String?

  /// متن پیام — برای کد یک‌بارمصرف ذخیره نمی‌شود تا کد لو نرود
  body String?

  /// وضعیت: sent | failed
  status String @default("sent")

  /// کانالی که واقعاً استفاده شد: kavenegar | log
  channel String

  /// نام سرویس‌دهنده — برای زمانی که چند سرویس پیامک پشتیبانی شود
  provider String @default("kavenegar")

  error String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

/// درگاه پرداخت بانکی.
///
/// درگاه‌ها در جدول نگه داشته می‌شوند تا فعال/غیرفعال‌کردن و تغییر حالت
/// آزمایشی بدون انتشار دوباره کد ممکن باشد. کلید فنی درگاه (`key`) باید با
/// شناسه‌ای که کد انتظار دارد یکی باشد، وگرنه درگاه ناشناخته نادیده گرفته می‌شود.
model PaymentGateway {
  id String @id @default(cuid())

  /// شناسه فنی: zarinpal | idpay | nextpay | saman | cod | installment
  key String @unique

  label       String
  description String?

  isActive  Boolean @default(false)
  isSandbox Boolean @default(true)

  /// مرچنت/ترمینال — این مقدار محرمانه نیست ولی از مرورگر خوانده نمی‌شود
  merchantId String?

  /// کلید API درگاه — محرمانه است و هرگز به مرورگر نمی‌رود
  apiKey String?

  sortOrder Int @default(0)

  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// رویدادهای ارسالی به اتوماسیون (n8n / Make).
///
/// قبلاً ارسال رویداد «آتش و فراموش» بود: اگر n8n خاموش بود، رویداد بی‌صدا
/// از دست می‌رفت و هیچ ردپایی نمی‌ماند. این جدول رویداد را نگه می‌دارد تا
/// وضعیت ارسال دیده شود، خطا عیب‌یابی گردد و ارسال دوباره ممکن باشد.
model AutomationEvent {
  id String @id @default(cuid())

  /// نام رویداد، مثلاً order.created
  event String

  /// داده رویداد به شکل JSON متنی (SQLite نوع Json ندارد)
  payload String

  /// وضعیت: sent | failed | skipped
  status String @default("sent")

  attempts Int @default(1)

  responseStatus Int?
  lastError      String?
  sentAt         DateTime?

  createdAt DateTime @default(now())

  @@index([event])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  امنیت
// ─────────────────────────────────────────────────────────────

/// لاگ حسابرسی — هر عمل حساس مدیر ثبت می‌شود.
/// بدون این جدول، پاسخ به «چه کسی این قیمت را عوض کرد؟» ناممکن است.
model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// عمل انجام‌شده، مثل order.status_changed
  action String

  /// نوع موجودیت، مثل Order
  entity   String
  entityId String?

  /// جزئیات به شکل JSON متنی (SQLite نوع Json ندارد)
  metadata String?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  کاتالوگ — پیش‌تر درون‌حافظه بود و برای افزودن کالا باید کد ویرایش
//  می‌شد. حالا این سه جدول منبع حقیقت‌اند و پنل مدیریت روی آن‌ها کار می‌کند.
// ─────────────────────────────────────────────────────────────

/// یک کالای فروشگاه.
///
/// نکته‌های طراحی:
///  • آرایه‌ها (نکته‌ها، مشخصات، تصاویر، تگ‌ها، نامک‌های مرتبط) به شکل
///    JSON متنی ذخیره می‌شوند، چون SQLite آرایه اسکالر ندارد و نگه‌داشتن
///    اسکیما «بدون @db.* و بدون enum» همان چیزی است که انتقال به
///    PostgreSQL را به تغییر provider محدود می‌کند.
///  • دسته و برند با **نامک** ارجاع داده می‌شوند (نه شناسه خارجی)، هم‌راستا با
///    الگوی موجود پروژه (`OrderItem.productSlug`, `Review.productSlug`).
///  • `isActive` حذف نرم است: کالای حذف‌شده از فروشگاه می‌رود ولی سفارش‌های
///    قدیمی‌اش دست‌نخورده می‌ماند.
model Product {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// نامک دسته (مثل refrigerator) و نامک برند (مثل samsung)
  categorySlug String
  brandSlug    String

  /// قیمت به تومان — 0 یعنی «تماس بگیرید»
  price Int
  /// قیمت پیش از تخفیف؛ اگر بزرگ‌تر از price باشد درصد تخفیف نمایش داده می‌شود
  compareAtPrice Int?

  stock Int @default(0)

  /// امتیاز و تعداد نظر نمایشی — مقدار بازاریابی قابل ویرایش در پنل.
  /// نظرهای واقعی کاربران در جدول Review می‌مانند و جداگانه نمایش داده می‌شوند.
  rating      Float @default(0)
  reviewCount Int   @default(0)

  shortDescription String
  description      String @default("")

  highlights   String @default("[]")
  specs        String @default("[]")
  attributes   String @default("{}")
  images       String @default("[]")
  tags         String @default("[]")
  relatedSlugs String @default("[]")

  videoUrl    String?
  publishedAt DateTime @default(now())

  /// حذف نرم — کالای غیرفعال در فروشگاه دیده نمی‌شود ولی رکوردش می‌ماند
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorySlug])
  @@index([brandSlug])
  @@index([isActive])
  @@index([price])
  @@index([createdAt])
}

/// دسته‌بندی کالا — صفحه اختصاصی دسته و متن سئو از همین ردیف می‌آید.
model Category {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  /// نام لاتین برای URL و سئو
  nameEn String

  description String @default("")
  seoIntro    String @default("")

  /// نامک آیکون در `components/ui/appliance-icon`
  icon String @default("refrigerator")

  featured  Boolean @default(true)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// برند — صفحه برند، نوار برندها و فیلتر برند از همین ردیف می‌خوانند.
model Brand {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  nameEn String @default("")
  /// کشور مبدأ
  origin String @default("")

  description String @default("")

  featured  Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
