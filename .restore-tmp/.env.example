[TEMPLATE]
# ── عمومی ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://noudalife.ir"
APP_VERSION="1.0.0"

# ── دیتابیس (Prisma) ─────────────────────────────────────
# پیش‌فرض توسعه: یک دیتابیس فایلی SQLite که بدون هیچ سرویس بیرونی کار می‌کند.
# برای تولید فقط provider و همین آدرس را عوض کنید (جزئیات در docs/ARCHITECTURE.md):
#   DATABASE_URL="postgresql://nodehi:password@localhost:5432/nodehi?schema=public"
DATABASE_URL="file:./dev.db"

# ── cach ───────────────────────────────────────────────────
# محدودیت نرخ فعلاً در حافظه فرآیند است. برای اجرای چندنمونه‌ای به Redis منتقل شود.
REDIS_URL="redis://localhost:6379"

# ── احراز هویت (ورود با شماره همراه + کد یک‌بارمصرف) ──────
# رمز عبور و NextAuth وجود ندارد؛ ورود فقط با OTP پیامکی انجام می‌شود.
# پیاده‌سازی: src/lib/server/auth/
#
# طول عمر نشست ورود (روز)
AUTH_SESSION_DAYS="30"
# اعتبار کد یک‌بارمصرف (ثانیه)
AUTH_OTP_TTL_SECONDS="120"
# ⚠️ فقط برای توسعه: کد را در پاسخ API برمی‌گرداند تا بدون سرویس پیامک هم
# بتوان وارد شد. وقتی NODE_ENV=production باشد این مقدار نادیده گرفته می‌شود
# و کد هرگز در پاسخ برنمی‌گردد.
AUTH_OTP_DEV_MODE="1"
# شماره‌ای که با `npm run db:seed` نقش «مدیر کل» می‌گیرد
SEED_ADMIN_PHONE="09120000000"
# ── اتوماسیون ────────────────────────────────────────────
# توکن نصب وب — باید روی هاست عمومی حتماً تنظیم شود (مثبت نگه‌داری برای قفل نصب)
# اگر خالی بماند، /install همیشه باز می‌ماند (غیر ایمن برای هاست عمومی)
# تنظیم شده است: openssl rand -hex 32
INSTALL_TOKEN=""

# ── پیامک (کاوه‌نگار) ─────────────────────────────────────
SMS_PROVIDER="kavenegar"
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER="10008663"
# قالب پیامک کد ورود (verify/lookup). خالی بماند، حالت توسعه فعال می‌شود.
KAVENEGAR_OTP_TEMPLATE=""

# ── ایمیل ────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@nodehi.ir"

# ── درگاه پرداخت (زرین‌پال) ───────────────────────────────
# چرخه واقعی پرداخت:
#   POST /api/checkout  →  هدایت به StartPay  →
#   GET /api/payments/zarinpal/callback  →  صفحه /checkout/result
#
# ⚠️ اولویت با پنل مدیریت است: /admin/payments (فعال بودن، حالت آزمایشی و
# شناسه پذیرنده). این متغیرها فقط مقدارهای جایگزین‌اند: اگر مدیر در پنل درگاه
# را خاموش کند، هیچ پرداخت آنلاینی — حتی با درخواست دستی به API — آغاز نمی‌شود.
#
# شناسه پذیرنده (merchant_id). راز نیست و در پنل مدیریت هم قابل ویرایش است.
ZARINPAL_MERCHANT_ID=""
# آدرس بازگشت از درگاه. زرین‌پال آن را با دامنه ثبت‌شده پذیرنده مقایسه می‌کند؛
# در تولید باید دقیقاً دامنه سایت باشد وگرنه درگاه تراکنش را با خطای ‎-14 رد
# می‌کند. خالی بماند، از NEXT_PUBLIC_SITE_URL ساخته می‌شود.
ZARINPAL_CALLBACK_URL=""
# فقط برای آزمون محلی یا پروکسی: جایگزین کردن آدرس خود درگاه.
# با این دو می‌توان با یک درگاه شبیه‌سازی‌شده کل چرخه را بدون پول واقعی سنجید.
ZARINPAL_API_BASE=""
ZARINPAL_STARTPAY_BASE=""
# آیدی‌پی هنوز پیاده نشده است؛ درگاه فعال فقط زرین‌پال است.
IDPAY_API_KEY=""
PAYMENT_CALLBACK_URL="https://nodehi.ir/api/webhooks/order-paid"

# ── حمل و نقل ────────────────────────────────────────────
TIPAX_API_KEY=""
POST_API_KEY=""

# ── ذخیره-storage تصاویر (آروان/لیارا) ────────────────────
S3_ENDPOINT=""
S3_BUCKET="nodehi-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── تنظیمات پنل مدیریت ───────────────────────────────────
# رمزنگاری مقدارهای حساس پنل (کلید API پیامک، کلید امضای وبهوک) با AES-256-GCM.
# اگر خالی باشد مقدارها متن ساده در جدول Setting ذخیره می‌شوند و پنل هشدار می‌دهد.
# کلید ۳۲ بایتی: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=""

# ── اتوماسیون ────────────────────────────────────────────
# آدرس دریافت رویدادها در n8n / Make (خروجی). اگر خالی بماند، رویدادها
# بی‌صدا نادیده گرفته می‌شوند و ثبت سفارش هرگز متوقف نمی‌گردد.
AUTOMATION_WEBHOOK_URL=""
# کلید امضای HMAC برای رویدادهای خروجی — با: openssl rand -hex 32
AUTOMATION_WEBHOOK_SECRET=""
# کلید بررسی امضای وبهوک ورودی /api/webhooks/order-paid.
# بدون تنظیم این مقدار، آن مسیر با پاسخ ۵۰۳ بسته می‌ماند (حالت امن).
# با: openssl rand -hex 32 بسازید و در تنظیمات درگاه هم وارد کنید.
NODEHI_WEBHOOK_SECRET=""
# دسترسی API به n8n برای سناریوهای سفارشی (اختیاری)
N8N_API_KEY=""

# ── چت‌بات ───────────────────────────────────────────────
CHATBOT_PROVIDER="custom"
CHATBOT_API_KEY=""

# ── مارکت‌پلیس و یکپارچه‌سازی‌ها ─────────────────────────
# جای اتصال سرویس‌های بیرونی در پنل: /admin/integrations
# همه پیش‌فرض خاموش‌اند؛ اولویت با مقدار پنل است و این متغیرها فقط مقدار اولیه‌اند.
# اسنپ‌پی (پرداخت اعتباری) — اتصال واقعی هنوز پیاده‌سازی نشده است
SNAPPAY_MERCHANT_ID=""
SNAPPAY_API_KEY=""
# دیجی‌کالا (فروشنده) — اتصال واقعی هنوز پیاده‌سازی نشده است
DIGIKALA_SELLER_ID=""
DIGIKALA_VENDOR_API_KEY=""
# ترب — با فعال‌سازی در پنل، مسیر /api/feeds/torob فهرست کالاها را می‌دهد
TOROB_API_KEY=""