// ─────────────────────────────────────────────────────────────────────────────
//  اسکیمای دیتابیس فروشگاه نودهی (PostgreSQL + Prisma)
// ─────────────────────────────────────────────────────────────────────────────
//  این فایل طرح داده‌ای است که لایه فعلی `src/lib/data/*` را جایگزین می‌کند.
//  برای استفاده:
//      npm i -D prisma && npm i @prisma/client
//      mv docs/prisma/schema.prisma prisma/schema.prisma
//      npx prisma migrate dev --name init
//
//  نکات طراحی مهم:
//   • قیمت‌ها به «ریال» و به‌صورت Int ذخیره می‌شوند تا از خطای اعشاری جلوگیری شود.
//   • برای پول از Decimal استفاده نشده چون ریال همیشه عدد صحیح است و BigInt
//     در JSON سرکشی می‌کند؛ Int تا ۲.۱ میلیارد ریال (۲۱۰ میلیون تومان) جا
//     می‌دهد و برای اقلام گران‌تر از BigInt استفاده کنید اگر لازم شد.
//   • همه فیلدهای سئو (slug، title، description) ایندکس دارند چون صفحه محصول
//     پرترافیک‌ترین مسیر سایت است.
//   • اطلاعات کارت بانکی در هیچ جدولی وجود ندارد (انطباق PCI-DSS).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── کاربران و دسترسی ───────────────────────────

enum Role {
  CUSTOMER // مشتری عادی
  OPERATOR // اپراتور انبار و سفارش
  ACCOUNTANT // حسابدار — فقط گزارش‌های مالی
  ADMIN // مدیر کل
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique // ورود پیامکی — شناسه اصلی کاربر ایرانی
  phoneVerified DateTime?
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String? // فقط برای ورود با ایمیل؛ هش Argon2id
  role          Role      @default(CUSTOMER)

  // احراز هویت دو مرحله‌ای — برای نقش‌های مدیریتی اجباری است
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // رمزنگاری‌شده در سطح برنامه پیش از ذخیره

  // امنیت
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?

  // باشگاه مشتریان
  loyaltyPoints Int      @default(0)
  loyaltyTier   String   @default("برنزی")
  totalSpent    Int      @default(0) // مجموع خرید به ریال

  marketingOptIn Boolean @default(true) // رضایت برای پیامک/ایمیل تبلیغاتی

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // حذف نرم — سوابق مالی باید باقی بمانند

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  wishlist    WishlistItem[]
  cart        CartItem[]
  coupons     CouponRedemption[]
  auditLogs   AuditLog[]
  sessions    Session[]
  priceAlerts PriceAlert[]

  @@index([role])
  @@index([createdAt])
}

/// آدرس‌های ارسال کاربر
model Address {
  id         String  @id @default(cuid())
  userId     String
  title      String // خانه | محل کار
  receiver   String
  phone      String
  province   String
  city       String
  line       String
  postalCode String
  isDefault  Boolean @default(false)

  // نگهداری مختصات سبب می‌شود فیلد latitude/longitude برای سرویس‌های نقشه
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// جلسه ورود — پشتیبانی از خروج از همه دستگاه‌ها
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// کد یک‌بارمصرف پیامکی (OTP) برای ورود
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String // هش کد، نه خود کد
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?

  @@index([phone, expiresAt])
}

/// لاگ حسابرسی — هر کنش حساس مدیران ثبت می‌شود
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // ORDER_STATUS_CHANGED، PRODUCT_DELETED، ...
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────── کاتالوگ ───────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  nameEn      String
  description String?
  seoIntro    String? // متن سئوی اختصاصی صفحه دسته
  icon        String?
  featured    Boolean @default(false)
  position    Int     @default(0)

  // سئو
  metaTitle       String?
  metaDescription String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@index([featured])
}

model Brand {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  nameEn      String
  origin      String?
  description String?
  featured    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([featured])
}

model Product {
  id          String @id @default(cuid())
  sku         String @unique
  slug        String @unique
  name        String

  categoryId String
  brandId    String

  // قیمت‌ها به ریال — Int برای پرهیز از خطای اعشاری
  price          Int
  compareAtPrice Int? // قیمت پیش از تخفیف

  stock     Int     @default(0)
  lowStockThreshold Int @default(3) // آستانه هشدار موجودی بحرانی

  rating      Float @default(0) // میانگین امتیاز — با تریگر یا cron به‌روز می‌شود
  reviewCount Int   @default(0)

  shortDescription String
  description      String
  highlights       String[] // نکات کلیدی

  // ویژگی‌های قابل فیلتر
  capacity         Int?
  capacityUnit     String?
  energyRating     String?
  color            String?
  widthCm          Int?
  heightCm         Int?
  depthCm          Int?
  inverter         Boolean @default(false)
  warrantyMonths   Int     @default(18)
  madeIn           String?
  installmentAvailable Boolean @default(true)
  readyToShip      Boolean @default(false)

  // رسانه
  images   String[] // مسیرهای مخزن آروان/لیارا
  videoUrl String?

  // سئو
  metaTitle       String?
  metaDescription String?

  status    ProductStatus @default(ACTIVE)
  publishedAt DateTime    @default(now())
  tags      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  category  Category          @relation(fields: [categoryId], references: [id])
  brand     Brand             @relation(fields: [brandId], references: [id])
  specs     ProductSpec[]
  reviews   Review[]
  cartItems CartItem[]
  wishlist  WishlistItem[]
  orderItems OrderItem[]
  priceAlerts PriceAlert[]
  relatedFrom ProductRelation[] @relation("RelatedFrom")
  relatedTo   ProductRelation[] @relation("RelatedTo")

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([price])
  @@index([status, publishedAt])
  @@index([rating])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// مشخصات فنی — جدول جداگانه تا فیلتر و مقایسه پویا ممکن باشد
model ProductSpec {
  id        String @id @default(cuid())
  productId String
  group     String // general | technical | dimensions | energy
  label     String
  value     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([label])
}

/// محصولات مشابه (خودارجاع) — جایگزین آرایه relatedSlugs
model ProductRelation {
  id            String @id @default(cuid())
  fromProductId String
  toProductId   String

  fromProduct Product @relation("RelatedFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct   Product @relation("RelatedTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId])
}

// ─────────────────────────────── سفارش و پرداخت ────────────────────────────

enum OrderStatus {
  PENDING // ایجاد شده، منتظر پرداخت
  PAID // پرداخت تأیید شده
  PROCESSING // در حال آماده‌سازی انبار
  SHIPPED // تحویل شرکت حمل
  DELIVERED // تحویل مشتری
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ONLINE // درگاه زرین‌پال / آیدی‌پی
  CASH_ON_DELIVERY // پرداخت درب منزل
  INSTALLMENT // سرویس اعتبارسنجی (دیجی‌پی و مشابه)
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // ND-482913 — نمایشی برای مشتری
  userId      String?
  status      OrderStatus @default(PENDING)

  // مبالغ به ریال
  itemsTotal      Int
  discountTotal   Int @default(0)
  shippingTotal   Int @default(0)
  payableTotal    Int
  paidTotal       Int @default(0)

  paymentMethod PaymentMethod

  // اطلاعات گیرنده — کپی می‌شود تا تغییر آدرس کاربر، سابقه سفارش را عوض نکند
  receiverName  String
  receiverPhone String
  province      String
  city          String
  addressLine   String
  postalCode    String

  shippingMethod String // express | tipax | freight
  trackingCode   String?
  carrier        String?

  note       String?
  adminNote  String?

  couponId String?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon     Coupon?            @relation(fields: [couponId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  events     OrderEvent[]
  invoice    Invoice?
  automationJobs AutomationJob[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // اطلاعات کالا در لحظه خرید — قیمت و نام ممکن است بعداً عوض شود
  productName String
  productSku  String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

/// تراکنش درگاه — توکن و شناسه مرجع، بدون هیچ داده کارت
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Int
  gateway       String // zarinpal | idpay | cod | digipay
  method        PaymentMethod
  status        PaymentStatus @default(INITIATED)

  authority     String? // شناسه تراکنش درگاه
  referenceId   String? // شماره پیگیری پس از موفقیت
  cardPanMasked String? // فقط ۴ رقم آخر، برای نمایش به مشتری
  gatewayPayload Json? // پاسخ خام درگاه برای پیگیری اختلاف

  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?
  refundedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([referenceId])
  @@index([status])
}

enum PaymentStatus {
  INITIATED
  REDIRECTED
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

/// تاریخچه تغییر وضعیت — برای نمایش تایم‌لاین پیگیری سفارش
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  label     String
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  number        String   @unique
  issuedAt      DateTime @default(now())
  taxAmount     Int      @default(0)
  pdfUrl        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── تخفیف و کمپین ─────────────────────────────

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int // درصد یا مبلغ ثابت به ریال
  minSubtotal Int? // حداقل مبلغ سبد
  maxDiscount Int? // سقف تخفیف در حالت درصدی

  usageLimit       Int? // سقف کل استفاده
  perUserLimit     Int? @default(1)
  usedCount        Int  @default(0)

  // محدودیت دامنه
  categoryIds String[]
  brandIds    String[]
  productIds  String[]

  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([active, startsAt, endsAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([userId])
}

/// کمپین‌های زمان‌دار که روی قیمت محصول اثر می‌گذارند
model Campaign {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  bannerUrl   String?
  discountPercent Int?
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)

  productIds String[]

  createdAt DateTime @default(now())

  @@index([active, startsAt, endsAt])
}

// ─────────────────────────────── محتوا و نظرات ─────────────────────────────

model Review {
  id        String @id @default(cuid())
  productId String
  userId    String

  rating  Int
  title   String
  body    String

  verifiedPurchase Boolean @default(false)
  helpfulCount     Int     @default(0)
  reportedCount    Int     @default(0)

  status ReviewStatus @default(PENDING) // نیاز به تأیید ادمین
  adminReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // هر کاربر یک نظر برای هر محصول
  @@index([productId, status])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Article {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  excerpt  String
  body     String // Markdown
  category String // buying-guide | tutorial | comparison | maintenance

  authorId String?
  keywords String[]

  readingMinutes Int?
  coverUrl       String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  status    PublishStatus @default(DRAFT)
  publishedAt DateTime?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())

  @@index([status, publishedAt])
  @@index([category])
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Banner {
  id       String   @id @default(cuid())
  title    String
  imageUrl String
  linkUrl  String?
  position String // hero | category-strip | sidebar
  sortOrder Int     @default(0)
  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean  @default(true)

  @@index([position, active])
}

// ─────────────────────────────── سبد و علاقه‌مندی ──────────────────────────

/// سبد خرید سرورساید — برای کاربران وارد‌شده و بازیابی سبد رهاشده
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([addedAt]) // یافتن سبدهای رهاشده برای کمپین بازیابی
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

/// درخواست اطلاع‌دهی هنگام موجود شدن کالا
model PriceAlert {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  phone     String
  kind      AlertKind @default(BACK_IN_STOCK)
  targetPrice Int? // برای هشدار کاهش قیمت
  notifiedAt DateTime?
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, notifiedAt])
}

enum AlertKind {
  BACK_IN_STOCK
  PRICE_DROP
}

// ─────────────────────────────── انبار و تأمین ─────────────────────────────

model Warehouse {
  id        String @id @default(cuid())
  name      String
  city      String
  address   String?
  active    Boolean @default(true)

  stockMovements StockMovement[]
  inventories    Inventory[]
}

model Inventory {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int    @default(0)
  reserved    Int    @default(0) // رزرو شده برای سفارش‌های پردازش‌نشده

  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
}

/// هر تغییر موجودی با دلیل ثبت می‌شود — برای حسابرسی انبار
model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  delta       Int // مثبت برای ورود، منفی برای خروج
  reason      StockReason
  reference   String? // شماره سفارش یا فاکتور خرید
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([reason])
}

enum StockReason {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
  DAMAGE
  RESERVATION_RELEASE
}

model Supplier {
  id        String @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  leadTimeDays Int @default(7)
  active    Boolean @default(true)

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  number     String   @unique
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  totalCost  Int      @default(0)
  expectedAt DateTime?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([status])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

// ─────────────────────────────── همگام‌سازی کانال‌ها ────────────────────────

/// نگاشت کالا به مارکت‌پلیس‌ها (دیجی‌کالا، ترب) برای همگام‌سازی موجودی و قیمت
model ChannelListing {
  id        String @id @default(cuid())
  productId String
  channel   String // digikala | torob | website
  externalId String?
  externalUrl String?
  price     Int?
  stock     Int?
  lastSyncedAt DateTime?
  syncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, channel])
  @@index([channel, lastSyncedAt])
}

// ─────────────────────────────── اتوماسیون ─────────────────────────────────

/// صف کارهای خودکار — وضعیت هر سناریوی n8n/Make در همین جدول پیگیری می‌شود
model AutomationJob {
  id       String @id @default(cuid())
  type     String // order_processing | stock_sync | abandoned_cart | purchase_order ...
  status   AutomationStatus @default(QUEUED)
  payload  Json
  result   Json?
  attempts Int    @default(0)
  lastError String?

  orderId String?

  idempotencyKey String? @unique // جلوگیری از اجرای تکراری یک رویداد
  scheduledAt DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([type, status])
}

enum AutomationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// لاگ وب‌هوک‌های ورودی/خروجی — برای اشکال‌زدایی یکپارچه‌سازی‌ها
model WebhookLog {
  id        String   @id @default(cuid())
  direction WebhookDirection
  source    String // n8n | make | digikala | payment-gateway
  event     String?
  signature String?
  valid     Boolean  @default(true)
  payload   Json
  responseCode Int?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([valid])
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

/// پیام‌های ارسالی (پیامک/ایمیل) — برای جلوگیری از ارسال تکراری و گزارش
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  channel   NotifyChannel
  template  String
  recipient String
  subject   String?
  body      String?
  status    NotifyStatus @default(QUEUED)
  providerId String?
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId, template])
}

enum NotifyChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotifyStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
}
