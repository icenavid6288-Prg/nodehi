# آدرس API لاراول.
# خالی یا حذف‌شده یعنی درخواست‌ها به `/api` می‌روند و Vite آن‌ها را در توسعه
# به http://127.0.0.1:8000 پروکسی می‌کند. در تولید آدرس مطلق بدهید:
# VITE_API_URL="https://api.example.com/api"
VITE_API_URL=

# دامنهٔ عمومی سایت برای canonical، Open Graph و sitemap.
# اگر خالی بماند، از `window.location.origin` استفاده می‌شود که برای ایندکس
# ماندگار مناسب نیست؛ در تولید حتماً مقدار بدهید:
# VITE_SITE_URL="https://example.com"
VITE_SITE_URL=
