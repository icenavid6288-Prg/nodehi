{
  "name": "nodehi-store",
  "version": "1.0.0",
  "private": true,
  "description": "فروشگاه اینترنتی لوازم خانگی نودهی — API لاراول + فرانت‌اند React",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:seo": "npm --prefix frontend run build:seo",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "php backend/artisan test",
    "seo:prerender": "npm --prefix frontend run prerender",
    "seo:refresh": "npm --prefix frontend run prerender:refresh",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
